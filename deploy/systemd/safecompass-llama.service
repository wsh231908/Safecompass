[Unit]
Description=SafeCompass local Llama-3-70B AWQ vLLM API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=u2023202105
Group=u2023202105
WorkingDirectory=/home/u2023202105/Safecompass
Environment=PYTHONUNBUFFERED=1
Environment=GPU_ID=0
Environment=JUDGE_PORT=8002
Environment=MAX_MODEL_LEN=2048
Environment=MAX_NUM_SEQS=1
Environment=GPU_MEMORY_UTILIZATION=0.75
Environment=QUANTIZATION=awq_marlin
Environment=DISABLE_FRONTEND_MULTIPROCESSING=1
Environment=JUDGE_MODEL=/home/u2023202105/models/llama-3-70b-instruct-awq
Environment=SERVED_MODEL_NAME=meta-llama/Llama-3-70b-chat-hf
Environment=VLLM_PYTHON=/fs/fast/share/aimind_files/conda/envs/video-eval/bin/python
Environment=HF_ENDPOINT=https://hf-mirror.com
Environment=HF_HOME=/home/u2023202105/.cache/huggingface
EnvironmentFile=-/etc/safecompass/llama.env
ExecStart=/home/u2023202105/Safecompass/scripts/start_llama70b_awq_judge.sh
Restart=on-failure
RestartSec=20
TimeoutStartSec=infinity
TimeoutStopSec=120
KillSignal=SIGTERM
KillMode=mixed
LimitNOFILE=1048576
SyslogIdentifier=safecompass-llama

[Install]
WantedBy=multi-user.target
